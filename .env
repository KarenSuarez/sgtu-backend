DB_PG_USER=sgtu_user
DB_PG_HOST=localhost
DB_PG_DATABASE=sgtu_db
DB_PG_PASSWORD=123456
DB_PG_PORT=5432
DB_PG_SSL=false # Cambiar a 'true' si usas SSL en producción

DB_MONGO_URI=mongodb://localhost:27017/sgtu_logs # En Docker Compose, se usará 'mongodb://mongodb:27017/sgtu_logs' para el backend
DB_MONGO_DATABASE_NAME=sgtu_logs

JWT_SECRET=jwt_secret_key
JWT_EXPIRES_IN=1h

PORT=3000

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Email Configuration (for Nodemailer)
EMAIL_SERVICE=gmail # e.g., 'gmail', 'SendGrid', 'Mailgun'
EMAIL_USER=sgtu.info@gmail.com # Tu correo electrónico de envío
EMAIL_PASS=offq vxmh azmk oewk # Contraseña o app password (si usas Gmail, genera una app password)
EMAIL_FROM_NAME=SGTU - INFO # Nombre que aparecerá como remitente